[run]
branch = True

# pipeline.py (1300+ lines, the 18-step orchestrator), main.py and config.py
# are top-level MODULES. They were absent from source_pkgs, so the single most
# complex file in the repository was not measured at all — while examples/
# (2000+ statements of demo scripts) WAS measured and counted at 100%, padding
# the headline number. `source = .` includes top-level modules; examples/ is
# omitted from the denominator.
source = .

omit =
    tests/*
    examples/*
    delete_pycache.py
    setup.py
    */__pycache__/*
    */site-packages/*
    */.venv/*
    build/*
    dist/*
    # Needs PyMC, which requires numpy>=2 and so cannot share this environment;
    # covered by the `estimation-pymc` CI job (tests/test_estimation_pymc.py).
    estimation/pymc_models.py

[report]
show_missing = True
skip_covered = False
precision = 1

exclude_also =
    if TYPE_CHECKING:
    raise NotImplementedError
    @(abc\.)?abstractmethod
    if __name__ == .__main__.:
    class .*\bProtocol\):

omit =
    tests/*
    examples/*
    delete_pycache.py
    setup.py
    */__pycache__/*
    */site-packages/*
    */.venv/*
    build/*
    dist/*
    estimation/pymc_models.py

[xml]
output = coverage.xml
